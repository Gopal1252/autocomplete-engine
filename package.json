{
  "name": "autocomplete-engine",
  "version": "1.0.0",
  "description": "Search autocomplete backend with trie-based prefix search, ranking, caching, and fuzzy matching",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --no-warnings --loader ts-node/esm src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
